{
  "name": "dynamic-island",
  "version": "1.1.0",
  "description": "A minimal, old-money dynamic island for Windows",
  "author": "Dynamic Island",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.dynamicisland",
    "productName": "Dynamic Island",
    "files": ["main.js", "preload.js", "index.html", "media.ps1", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": true, "runAfterFinish": true }
  }
}
